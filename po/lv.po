msgid ""
"Usage: nano [OPTIONS] [[+LINE[,COLUMN]] FILE]...\n"
"\n"
msgstr ""
"Lietojums: nano [OPCIJAS] [[+RINDA[,KOLONNA]] FAILS]...\n"
"\n"

#. TRANSLATORS: The next two strings are part of the --help output.
#. * It's best to keep its lines within 80 characters.
#: src/nano.c:496
#, c-format
msgid ""
"To place the cursor on a specific line of a file, put the line number with\n"
"a '+' before the filename.  The column number can be added after a comma.\n"
msgstr ""
"Lai novietotu kursoru konkrētā faila rindā, pirms faila nosaukuma ievietojiet\n"
"rindas numuru ar '+'. Kolonnas numuru var pievienot aiz komata.\n"

#: src/nano.c:498
#, c-format
msgid ""
"When a filename is '-', nano reads data from standard input.\n"
"\n"
msgstr ""
"Kad faila nosaukums ir '-', nano lasa datus no standarta ievades.\n"
"\n"

#. TRANSLATORS: The next three are column headers of the --help output.
